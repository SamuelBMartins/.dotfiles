{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "tmn73.calendar",
    "layout": {
      "left": [
        {
          "id": "smartins.menu"
        },
        {
          "id": "smartins.mirador-button"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators",
          "items": [
            "ScreenRecording",
            "NightLight",
            "Dnd",
            "StayAwake"
          ]
        },
        {
          "id": "tmn73.calendar",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "pinned": [
            "spotifast",
            "zapfast",
            "chrome_status_icon_1"
          ],
          "hidden": []
        },
        {
          "id": "akshad135.anisync"
        },
        {
          "id": "io.github.elevate08.qs-bitwarden-cli",
          "lockOnScreenLock": false,
          "autoLockMinutes": 0
        },
        {
          "id": "jkoestinger.vpn"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "mirador"
    }
  ],
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "smartins.menu"
  ]
}
