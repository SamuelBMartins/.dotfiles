[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair nextcloud_sync]
a = "local_calendars"
b = "nextcloud_calendars"
collections = ["from b"]
implicit = "create"

[storage local_calendars]
type = "filesystem"
path = "~/.local/share/vdirsyncer/calendars/"
fileext = ".ics"

[storage nextcloud_calendars]
type = "caldav"
url = "https://drive.smartins.ch/remote.php/dav/"
username = "smartins"
password.fetch = ["command", "secret-tool", "lookup", "service", "nextcloud-vdirsyncer", "user", "smartins"]
read_only = true

[pair work_subscription]
a = "work_local"
b = "work_remote"
collections = null

[storage work_local]
type = "filesystem"
path = "~/.local/share/vdirsyncer/calendars/work/"
fileext = ".ics"

[storage work_remote]
type = "caldav"
url = "https://drive.smartins.ch/remote.php/dav/calendars/smartins/calendargooglecom-2/"
username = "smartins"
password.fetch = ["command", "secret-tool", "lookup", "service", "nextcloud-vdirsyncer", "user", "smartins"]
useragent = "Evolution/3.54"
read_only = true
