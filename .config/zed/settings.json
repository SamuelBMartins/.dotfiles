// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://crates\\.io",
            },
          ],
          "default": "allow",
        },
        "terminal": {
          "default": "allow",
        },
      },
    },
    "default_model": {
      "provider": "amazon-bedrock",
      "model": "minimax-m2-5",
      "enable_thinking": false,
    },
    "favorite_models": [
      {
        "provider": "amazon-bedrock",
        "model": "minimax-m2-5",
        "enable_thinking": false,
      },
    ],
    "model_parameters": [],
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "medium",
        "model": "gpt-5.4"
      },
      "type": "registry",
    },
  },
  "edit_predictions": {
    "provider": "mercury",
  },
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "vim": {
    "gdefault": true,
  },
  "disable_ai": false,
  "base_keymap": "VSCode",
  "vim_mode": true,
  "ui_font_size": 15,
  "buffer_font_size": 15,
  "show_wrap_guides": true,
  "wrap_guides": [80],
  "theme": {
    "mode": "system",
    "light": "Gruvbox Dark",
    "dark": "One Dark",
  },
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
  "title_bar": {
    "show_sign_in": false,
  },
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "restore_on_startup": "launchpad",
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "auto_install_extensions": {
    "java": true,
    "dockerfile": true,
    "biome": true,
    "sql": true,
  },
  "languages": {
    "Java": {
      "format_on_save": "off",
      "wrap_guides": [100],
      "formatter": [
        {
          "code_action": "source.organizeImports",
        },
        "language_server",
      ],
    },
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "jdtls": {
      "settings": {
        "jdk_auto_download": true,
        "lombok_support": true,
      },
    },
  },
}
