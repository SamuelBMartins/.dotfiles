[user]
	email = s@smartins.ch
	name = Samuel Martins
[core]
	editor = nvim
[pull]
	rebase = true
[commit]
	gpgsign = true
[init]
	defaultBranch = master
[push]
	autoSetupRemote = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
